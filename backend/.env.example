APP_NAME=SpeedPilot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Railway Postgres instance. Either set DATABASE_URL alone (Railway provides this)
# or the discrete DB_* values below - config/database.php reads DATABASE_URL first.
DATABASE_URL=
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=speedpilot
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Shopify Partner app credentials (supplied later) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_SCOPES=read_themes,write_themes,read_products,read_script_tags,write_script_tags
SHOPIFY_APP_URL="${APP_URL}"

# --- Frontend (Remix embedded app) ---
FRONTEND_URL=http://localhost:3000

# --- Scanner microservice ---
SCANNER_URL=http://127.0.0.1:4000

# --- PageSpeed Insights (quota-limited spot checks) ---
PSI_API_KEY=
PSI_DAILY_QUOTA=100

# --- Phase 4: AI recommendation provider (placeholder until a real key is added) ---
AI_PROVIDER=placeholder
AI_PROVIDER_API_KEY=

VITE_APP_NAME="${APP_NAME}"
