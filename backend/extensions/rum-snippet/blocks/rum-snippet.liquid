<script>
  window.SpeedPilotConfig = {
    shopDomain: {{ shop.permanent_domain | json }},
    backendUrl: {{ block.settings.backend_url | json }}
  };
</script>
<script src="{{ 'rum.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "SpeedPilot RUM",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "backend_url",
      "label": "SpeedPilot backend URL",
      "default": "https://speedpilot-production.up.railway.app"
    }
  ]
}
{% endschema %}
